# syntax=docker/dockerfile:1

# Keep both stages on one configurable base.  A host which has already cached
# node:20-bookworm must not need a second Docker Hub request for the slim tag
# just to create the runtime stage.  The full image is slightly larger, but it
# is also the image used by the development stack and is therefore normally
# already present on an offline/air-gapped host.
ARG SANDBOX_RUNTIME_BASE=node:20-bookworm

# ---- Build stage: compile TypeScript + node-pty's native addon ----
FROM ${SANDBOX_RUNTIME_BASE} AS builder
WORKDIR /app

# node-pty needs a native toolchain to build its addon during `npm install`.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package.json tsconfig.json ./
RUN npm install

COPY src ./src
RUN npm run build

# ---- Runtime stage: lean image actually used for spawned sandboxes ----
FROM ${SANDBOX_RUNTIME_BASE} AS runtime
ARG SANDBOX_SOURCE_SHA=unknown
ARG SANDBOX_BASE_IMAGE_ID=unknown
LABEL org.live.sandbox.source-sha="${SANDBOX_SOURCE_SHA}" \
      org.live.sandbox.base-image-id="${SANDBOX_BASE_IMAGE_ID}"
WORKDIR /app

# tini       - PID 1 init; reaps zombie processes spawned by the interactive shell
# bash       - default sandbox shell
# coreutils  - baseline shell utilities
# procps     - ps/top, useful for introspecting the sandbox from inside
# curl       - used by the container HEALTHCHECK
# stress-ng  - used by Phase 1 verification to trigger and observe OOM kills
RUN apt-get update && apt-get install -y --no-install-recommends \
      tini bash coreutils procps curl stress-ng \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system sandbox \
    && useradd --system --create-home --gid sandbox --shell /bin/bash sandbox \
    && mkdir -p /workspace \
    && chown -R sandbox:sandbox /workspace /app

COPY --from=builder --chown=sandbox:sandbox /app/dist ./dist
COPY --from=builder --chown=sandbox:sandbox /app/node_modules ./node_modules
COPY --from=builder --chown=sandbox:sandbox /app/package.json ./package.json

USER sandbox
ENV NODE_ENV=production \
    PORT=7777 \
    SANDBOX_WORKDIR=/workspace
WORKDIR /workspace

EXPOSE 7777

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -sf http://localhost:7777/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "/app/dist/server.js"]
