{
  "name": "live-session-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "dev": "pnpm --parallel -r run dev",
    "dev:streaming": "pnpm --filter @live/streaming run dev",
    "dev:web": "pnpm --filter @live/web run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint:no-any": "! grep -RIn --include='*.ts' --include='*.tsx' -E '\\bany\\b' packages/shared-types/src"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
